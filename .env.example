# Copy this file to ".env" and change values if you need to. All are optional.

# "claude" = real drafts via Claude Code (your subscription). "mock" = fake drafts for testing.
AI_PROVIDER=claude

# Optional: pick a model alias, e.g. sonnet or opus. Leave empty for Claude Code's default.
CLAUDE_MODEL=

PORT=3000

# Keep 127.0.0.1 (this computer only) unless you want to open the dashboard on your iPad.
# For iPad on the same Wi-Fi: HOST=0.0.0.0 and set a long ACCESS_PASSWORD.
HOST=127.0.0.1
ACCESS_PASSWORD=
